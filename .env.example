# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# The demo runs with everything below left at its defaults — see DEMO_MODE.
# ---------------------------------------------------------------------------

# --- Demo mode -------------------------------------------------------------
# true  : offline stubs for the LLM, embeddings and vector store. No network,
#         no credentials, no external services. Good for a first run and CI.
# false : use the providers configured below.
DEMO_MODE=true

# --- Corpus ----------------------------------------------------------------
# Directory of knowledge domains. Each immediate subdirectory is one domain.
DATA_DIR=data

# How the index is brought up at start-up:
#   auto     - attach to existing collections, index anything missing (default)
#   retrieve - attach only; never read the corpus (fastest start-up)
#   index    - re-index every domain from disk
INIT_MODE=auto

# Which answering pipeline to run: simple_rag | react_agent
RAG_PIPELINE=simple_rag

# --- Chat model ------------------------------------------------------------
# openai : any OpenAI-compatible /chat/completions endpoint — the hosted API,
#          or a self-hosted vLLM / Ollama / gateway. Set LLM_BASE_URL for the
#          latter and leave it empty for api.openai.com.
# echo   : offline stub used by demo mode. No inference.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1500

# --- Embeddings ------------------------------------------------------------
# openai  : any OpenAI-compatible /embeddings endpoint.
# hashing : offline deterministic embedder used by demo mode. Not semantic.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=8

# --- Vector store ----------------------------------------------------------
# milvus : a Milvus / Zilliz deployment. The bundled compose file starts one
#          locally at http://localhost:19530 with auth disabled.
# memory : in-process brute-force index. Demo and tests only.
VECTOR_STORE=milvus
VECTOR_STORE_URI=http://localhost:19530
VECTOR_STORE_USER=
VECTOR_STORE_PASSWORD=
VECTOR_STORE_DB=default
VECTOR_COLLECTION_PREFIX=kb_

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# --- API service -----------------------------------------------------------
# Shared secret required by every authenticated endpoint. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_BASE_URL=http://localhost:8000
API_MODEL_ID=multi-domain-rag
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:8502

# Externally reachable URL of the UI, used to build share links.
PUBLIC_BASE_URL=http://localhost:8502

# --- UI --------------------------------------------------------------------
APP_NAME=Knowledge Assistant

# --- Chat persistence (optional) -------------------------------------------
# Enables chat history and shareable answer links. Needs Postgres.
CHAT_PERSISTENCE_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragagent
DB_USERNAME=ragagent
DB_PASSWORD=

# Required by Chainlit when auth or persistence is enabled. Generate with:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=

# --- UI authentication (optional) ------------------------------------------
# Leave empty to run the UI anonymously. Supply your own OAuth app to enable
# sign-in; see docs/security.md.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# --- Source-code ingestion (optional, off by default) ----------------------
# Absolute path the /ingest/repository endpoint is allowed to read from.
# Leave empty to keep the endpoint disabled.
REPO_INGEST_ROOT=
